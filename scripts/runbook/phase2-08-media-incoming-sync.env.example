# Copy to /etc/media-incoming-sync.env and edit for your setup.
# chmod 0600 -- these are the only device-specific values the sync
# script needs; the script itself never changes between setups.

# Your media server's address and NFS export. Reached however you
# route to it (plain LAN, WireGuard, Tailscale, ...) -- this script
# only pings and mounts, it doesn't care which.
NFS_HOST=<media-server-ip>
NFS_EXPORT=<nfs-export-path>

# Sonarr/Radarr's own root folders on this box -- see phase2-apps.md
# Part 1. Not NZBGet's completed/ dir; see phase2-hardening.md Part 11
# for why.
SRC=/volume/media

LOG=/var/log/media-incoming-sync.log

# One MAPPING_SRC_N / MAPPING_DST_N pair per library, N starting at 1
# with no gaps. SRC is a subdirectory under $SRC above; DST is a path
# under $NFS_EXPORT. Add MAPPING_SRC_3/MAPPING_DST_3 and so on for
# additional libraries (music, books, ...).
MAPPING_SRC_1=tv
MAPPING_DST_1=TV_Shows

MAPPING_SRC_2=movies
MAPPING_DST_2=Movies
